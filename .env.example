# Konfigurasi bot. Salin file ini menjadi .env lalu isi nilainya.

# --- Wajib ---
# Token dari @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Akses ---
# Kosongkan = bot publik (siapa pun boleh pakai).
# Isi dengan daftar user ID dipisah koma untuk membatasi akses, contoh: 12345678,87654321
ALLOWED_USER_IDS=
# User ID yang boleh /cleanup all (batalkan unduhan & hapus file semua pengguna).
# Kosong = ALLOWED_USER_IDS dianggap admin.
ADMIN_USER_IDS=

# --- Penyimpanan ---
# Akar folder downloads/ dan tmp/ (kosongkan = folder project).
# Di container: /app/data dengan volume agar data tidak hilang saat image diganti.
DATA_DIR=

# --- Batas upload ---
# Bot API resmi Telegram membatasi 50 MB. Naikkan hanya jika memakai
# telegram-bot-api lokal (LOCAL_API_URL).
MAX_UPLOAD_MB=49
# Resolusi maksimum video YouTube (1080, 720, 480, ...)
MAX_VIDEO_HEIGHT=1080
# Batas durasi video yang diproses (detik), 0 = tanpa batas
MAX_DURATION_SECONDS=3600

# --- Kualitas / tools ---
# Path binary ffmpeg. Kosongkan agar dideteksi otomatis.
FFMPEG_LOCATION=
# Jumlah unduhan paralel
MAX_CONCURRENT_DOWNLOADS=2
# Hapus file sementara otomatis setelah N menit (0 = nonaktif)
TEMP_TTL_MINUTES=60

# --- TikTok (no watermark) ---
# API tikwm dipakai lebih dulu karena konsisten tanpa watermark.
# Set 0 untuk memakai yt-dlp saja.
TIKTOK_USE_TIKWM=1
TIKTOK_API_URL=https://www.tikwm.com/api/

# --- Cookies (opsional, untuk konten privat / rate limit) ---
# Taruh file Netscape cookies di folder cookies/ lalu isi nama filenya.
COOKIES_YOUTUBE=
COOKIES_INSTAGRAM=
COOKIES_TIKTOK=
# Alternatif: ambil cookies langsung dari browser (chrome, firefox, edge, brave)
COOKIES_FROM_BROWSER=

# --- Proxy opsional, contoh: http://127.0.0.1:8080 ---
PROXY_URL=
# Kompresi video lewat ffmpeg bila hasil unduhan melebihi MAX_UPLOAD_MB (1/0)
AUTO_COMPRESS=1
# Transcode otomatis video non-H.264 (mis. HEVC dari TikTok) agar bisa diputar di Telegram (1/0)
TRANSCODE_TO_H264=1

# --- Local Bot API server (opsional, untuk upload sampai 2 GB) ---
# contoh: http://127.0.0.1:8081
LOCAL_API_URL=
