# Bot configuration. Copy this file to .env and fill in the values.

# --- Required ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Access ---
# Leave empty for a public bot (anyone may use it).
# Comma-separated user IDs to restrict access, e.g. 12345678,87654321
ALLOWED_USER_IDS=
# User IDs allowed to run /cleanup all (cancel downloads and delete files for every user).
# Empty = ALLOWED_USER_IDS counts as admin.
ADMIN_USER_IDS=

# --- Storage ---
# Root for downloads/ and tmp/ (empty = the project folder).
# In containers: /app/data on a volume so data survives image upgrades.
DATA_DIR=

# --- Upload limits ---
# The official Telegram Bot API caps bot uploads at 50 MB. Raise this only when
# running a local telegram-bot-api (LOCAL_API_URL).
MAX_UPLOAD_MB=49
# Maximum YouTube video resolution (1080, 720, 480, ...)
MAX_VIDEO_HEIGHT=1080
# Maximum video duration in seconds (0 = unlimited)
MAX_DURATION_SECONDS=3600

# --- Quality / tooling ---
# Path to the ffmpeg binary. Leave empty for auto-detection.
FFMPEG_LOCATION=
# Number of parallel downloads
MAX_CONCURRENT_DOWNLOADS=2
# Delete temporary files after N minutes (0 = disabled)
TEMP_TTL_MINUTES=60

# --- TikTok (no watermark) ---
# The tikwm API is tried first because it is consistent about watermarks.
# Set to 0 to use the yt-dlp path only.
TIKTOK_USE_TIKWM=1
TIKTOK_API_URL=https://www.tikwm.com/api/

# --- Cookies (optional, for private content / rate limits) ---
# Put Netscape cookie files in cookies/ and reference the filename here.
COOKIES_YOUTUBE=
COOKIES_INSTAGRAM=
COOKIES_TIKTOK=
# Alternative: read cookies directly from a browser (chrome, firefox, edge, brave)
COOKIES_FROM_BROWSER=

# --- Optional proxy, e.g. http://127.0.0.1:8080 ---
PROXY_URL=
# Re-encode with ffmpeg when the download exceeds MAX_UPLOAD_MB (1/0)
AUTO_COMPRESS=1
# Transcode non-H.264 video (e.g. HEVC from TikTok) so Telegram plays it inline (1/0)
TRANSCODE_TO_H264=1

# --- Local Bot API server (optional, uploads up to 2 GB) ---
# e.g. http://127.0.0.1:8081
LOCAL_API_URL=