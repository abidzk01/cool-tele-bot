# Rootless Podman Quadlet unit for the Telegram bot.
#
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/appbot-telegram.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now appbot-telegram
#   journalctl --user -u appbot-telegram -f
#
# Prerequisites (see docs/DEPLOY.md):
#   podman build -t localhost/appbot-telegram:latest /opt/app_bot_telegram
#   mkdir -p /opt/app_bot_telegram/{downloads,tmp,cookies}
#
# UserNS=keep-id maps the host user to uid 1000 inside the container, so bind mounts
# owned by that user stay writable for the non-root process in the image.

[Unit]
Description=Telegram Bot (System Info + Media Downloader)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=appbot-telegram
Image=localhost/appbot-telegram:latest
EnvironmentFile=/opt/app_bot_telegram/.env
Environment=DATA_DIR=/app/data
UserNS=keep-id:uid=1000,gid=1000
Volume=/opt/app_bot_telegram/downloads:/app/data/downloads:Z
Volume=/opt/app_bot_telegram/tmp:/app/data/tmp:Z
Volume=/opt/app_bot_telegram/cookies:/app/cookies:ro,Z
# pull a newer image during `podman auto-update`
AutoUpdate=local

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=default.target